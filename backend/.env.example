# Copy this file to .env and fill in your real values.
# .env is in .gitignore and will never be committed.

# Required for chat + embeddings. Without it, /api/health reports
# openai_key_configured=false and chat returns a clear error.
OPENAI_API_KEY=sk-your-openai-key-here

# Deployment knobs (optional — defaults are fine for local dev)
# PORT=8000
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# FRONTEND_DIST=                 # set to frontend/dist inside Docker; empty = dev mode

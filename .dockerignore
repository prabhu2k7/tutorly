# Mirror .gitignore plus everything Docker doesn't need at build time

.git
.github
.gitignore
.gitattributes

# Secrets
.env
.env.local
.env.*.local

# Local Claude
.claude/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
.pytest_cache/
.mypy_cache/

# Node / built artifacts (Docker rebuilds inside the image)
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/

# Runtime data (ephemeral; never bake into image)
backend/chroma_db/
backend/uploads/
backend/kb_metadata.json

# Docs not needed inside the image
MVP_PLAN.md
TEST_PLAN.md
VS_CODE_SETUP.md
CLAUDE.md

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log

# Demo artifact files
demo_kb_id.txt
